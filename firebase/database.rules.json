{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('players').child(auth.uid).exists() || (data.child('status').val() === 'waiting' && newData.child('players').child(auth.uid).exists()))",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{4}$/) && newData.child('players').numChildren() <= 4"
      }
    }
  }
}
